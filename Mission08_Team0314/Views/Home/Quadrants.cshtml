@using Mission08_Team0314.Models
@model IEnumerable<Mission08_Team0314.Models.Task>

@{
    ViewData["Title"] = "Task Quadrants";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4 font-weight-bold">Task Matrix</h1>
        <p class="text-muted italic">"First Things First"</p>
    </div>

    @* The 2x2 Grid using Bootstrap *@
    <div class="row g-4">
        @for (int i = 1; i <= 4; i++)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header text-center @(i == 1 ? "bg-danger text-white" : i == 2 ? "bg-primary text-white" : i == 3 ? "bg-warning" : "bg-dark text-white")">
                        <h4 class="mb-0 py-2">
                            Quadrant @i
                            <span class="d-block small font-weight-normal mt-1" style="font-size: 0.7em;">
                                @(i == 1 ? "Urgent / Important" : i == 2 ? "Not Urgent / Important" : i == 3 ? "Urgent / Not Important" : "Not Urgent / Not Important")
                            </span>
                        </h4>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Task</th>
                                        <th>Due Date</th>
                                        <th>Category</th>
                                        <th class="text-right px-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Display only non-completed tasks for this specific quadrant *@
                                    @foreach (var t in Model.Where(x => x.Quadrant == i && !x.Completed))
                                    {
                                        <tr>
                                            <td class="align-middle pl-3">@t.TaskName</td>
                                            <td class="align-middle">@t.DueDate?.ToShortDateString()</td>
                                            <td class="align-middle">@(t.Category?.CategoryName ?? "General")</td>
                                            <td class="text-right pr-3">
                                                <div class="btn-group" role="group">
                                                    <form asp-action="MarkComplete" asp-route-id="@t.TaskId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Done</button>
                                                    </form>
                                                    <a asp-action="AddEdit" asp-route-id="@t.TaskId" class="btn btn-sm btn-outline-info ml-1">Edit</a>
                                                    <form asp-action="Delete" asp-route-id="@t.TaskId" method="post" class="d-inline ml-1" onsubmit="return confirm('Delete this task?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div> 