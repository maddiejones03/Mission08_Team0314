@model TModel

<form method="post">
    <input type="hidden" asp-for="TaskId"/>
    <label asp-for="TaskName">Task:</label>
    <input asp-for="TaskName"/>
    <br/>
    <label asp-for="DueDate">Due Date</label>
    <input asp-for="DueDate" type="datetime"/>
    <br/>
    <label asp-for="Quadrant">Quadrant (1 - 4):</label>
    <input asp-for="Quadrant"/>
    <select asp-for="CategoryId">
        <option value="0">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <label asp-for="Completed">Completed?</label>
    <select asp-for="Completed">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
</form>